{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Zevon",
  "version": "0.1.0",
  "identifier": "ai.zevon.desktop",
  "build": {
    "frontendDist": "../../services/api/static",
    "devUrl": "http://127.0.0.1:8000"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Zevon Assistant",
        "width": 1180,
        "height": 820,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
