{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zevon",
  "version": "0.2.0",
  "identifier": "ai.zevon.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [{ "title": "Zevon AI", "width": 1000, "height": 760, "minWidth": 380, "minHeight": 520 }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"] }
}
