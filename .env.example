JARVIS_LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
JARVIS_MODEL=qwen3:8b
# Folders Jarvis may touch (os.pathsep separated: ':' on Linux/macOS, ';' on Windows). Empty = no file access.
JARVIS_ALLOWED_FOLDERS=
# Set a long random token before exposing over Tailscale/LAN. Sent as "Authorization: Bearer <token>".
JARVIS_API_TOKEN=
JARVIS_DB=data/jarvis.db
JARVIS_GOOGLE_TOKEN=data/google_token.json
