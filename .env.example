# ---- Zevon Core ----
# Model provider: ollama (local) | openai (llama.cpp / vLLM / LM Studio / OpenAI / OpenRouter / Groq...) | anthropic
# NOTE: openai-compatible cloud endpoints and anthropic send your prompts to that company. Local ones keep them on your machine.
ZEVON_LLM_PROVIDER=ollama
ZEVON_MODEL=qwen3:8b
OLLAMA_HOST=http://localhost:11434
# for provider=openai, e.g. llama.cpp server: http://localhost:8080/v1   vLLM: http://localhost:8000/v1
ZEVON_OPENAI_BASE_URL=http://localhost:8080/v1
ZEVON_OPENAI_API_KEY=
# for provider=anthropic
ZEVON_ANTHROPIC_API_KEY=
# Agent behaviour: planning auto|always|off; older chat messages are summarized after this many
ZEVON_PLANNING=auto
ZEVON_SUMMARIZE_AFTER=30
ZEVON_HISTORY_KEEP=12
ZEVON_TIMEZONE=Asia/Kolkata
# Folders Zevon may touch (os.pathsep separated: ':' on Linux/macOS, ';' on Windows). Empty = no file access.
ZEVON_ALLOWED_FOLDERS=
# Set a long random token before exposing over Tailscale/LAN. Sent as "Authorization: Bearer <token>".
ZEVON_API_TOKEN=

# ---- Memory ----
# Semantic memory needs: pip install chromadb  and  ollama pull nomic-embed-text   (set to off to disable)
ZEVON_VECTOR_MEMORY=auto
ZEVON_EMBED_MODEL=nomic-embed-text

# ---- Voice (pip install -r backend/requirements-voice.txt) ----
ZEVON_WHISPER_MODEL=base
# Path to a Piper voice .onnx file (download from the Piper voices repo); empty = browser speech fallback
ZEVON_PIPER_MODEL=

# ---- Google (run scripts/google_auth.py once) ----
ZEVON_EMAIL_POLL_MIN=5

# ---- Third-party Extensions (set a token to enable) ----
ZEVON_NOTION_TOKEN=
ZEVON_NOTION_PARENT_PAGE=
ZEVON_TODOIST_TOKEN=
ZEVON_SLACK_TOKEN=

# ---- Browser / terminal limits ----
# Comma-separated domains the browser tool may open; empty = any public site (private IPs always blocked)
ZEVON_BROWSER_DOMAINS=
# Extra program names to allow in the restricted terminal (use with care)
ZEVON_TERMINAL_EXTRA=
# on = Zevon may ASK to run any other command (one program, no pipes); you approve the exact command each time
ZEVON_TERMINAL_ASK=off
# How often (minutes) calendar/file/Slack/time rules are checked
ZEVON_TRIGGER_POLL_MIN=1

# ---- Notifications ----
ZEVON_VAPID_SUBJECT=mailto:you@example.com
# Android push via Firebase: path to your Firebase service-account JSON (see docs/deployment.md)
ZEVON_FCM_SERVICE_ACCOUNT=
