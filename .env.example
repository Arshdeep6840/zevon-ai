# ---- Zevon Core ----
ZEVON_LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
ZEVON_MODEL=qwen3:8b
ZEVON_TIMEZONE=Asia/Kolkata
# Folders Zevon may touch (os.pathsep separated: ':' on Linux/macOS, ';' on Windows). Empty = no file access.
ZEVON_ALLOWED_FOLDERS=
# Set a long random token before exposing over Tailscale/LAN. Sent as "Authorization: Bearer <token>".
ZEVON_API_TOKEN=

# ---- Memory ----
# Semantic memory needs: pip install chromadb  and  ollama pull nomic-embed-text   (set to off to disable)
ZEVON_VECTOR_MEMORY=auto
ZEVON_EMBED_MODEL=nomic-embed-text

# ---- Voice (pip install -r backend/requirements-voice.txt) ----
ZEVON_WHISPER_MODEL=base
# Path to a Piper voice .onnx file (download from the Piper voices repo); empty = browser speech fallback
ZEVON_PIPER_MODEL=

# ---- Google (run scripts/google_auth.py once) ----
ZEVON_EMAIL_POLL_MIN=5

# ---- Third-party Extensions (set a token to enable) ----
ZEVON_NOTION_TOKEN=
ZEVON_NOTION_PARENT_PAGE=
ZEVON_TODOIST_TOKEN=
ZEVON_SLACK_TOKEN=

# ---- Browser / terminal limits ----
# Comma-separated domains the browser tool may open; empty = any public site (private IPs always blocked)
ZEVON_BROWSER_DOMAINS=
# Extra program names to allow in the restricted terminal (use with care)
ZEVON_TERMINAL_EXTRA=

# ---- Web Push ----
ZEVON_VAPID_SUBJECT=mailto:you@example.com
